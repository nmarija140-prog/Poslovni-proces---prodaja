unit ProdajaTura;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs,
  FMX.Controls.Presentation, FMX.StdCtrls, FMX.Objects, FMX.Ani, FMX.Layouts,
  Data.DB, Data.Win.ADODB, System.IniFiles, System.IOUtils;

type
  TForm8 = class(TForm)
    HambMeni2: TSpeedButton;
    KarticaPrihvacenePonude: TRectangle;
    RectAnimation1: TRectAnimation;
    Text4: TText;
    KarticaOdbijenePonude: TRectangle;
    RectAnimation2: TRectAnimation;
    Text1: TText;
    KarticaPoslatePonude: TRectangle;
    RectAnimation3: TRectAnimation;
    Text2: TText;
    KarticaNoviZahtevi: TRectangle;
    RectAnimation4: TRectAnimation;
    Text3: TText;
    NoviZahtevDugme: TSpeedButton;
    KarticaZahtevi: TRectangle;
    Text5: TText;
    ZahteviLista: TVertScrollBox;
    PanelProdaja: TPanel;
    operativaDugme: TButton;
    ProdajaTuraDugme: TButton;
    ChatDugme: TButton;
    IzvestajiDugme: TButton;
    MojProfilDugme: TButton;
    OdjavaDugme: TButton;
    ADOConnection1: TADOConnection;
    ADOQuery1: TADOQuery;
    procedure HambMeni2Click(Sender: TObject);
    procedure KarticaZahteviClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure KarticaNoviZahteviClick(Sender: TObject);
    procedure KarticaPoslatePonudeClick(Sender: TObject);
    procedure KarticaPrihvacenePonudeClick(Sender: TObject);
    procedure KarticaOdbijenePonudeClick(Sender: TObject);
    procedure NoviZahtevDugmeClick(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
  private
   procedure Filtriranje(StatusID: Integer);
  public

  end;

var
  Form8: TForm8;

implementation
uses NoviZahtev;
{$R *.fmx}

procedure TForm8.FormCreate(Sender: TObject);
var
  dbPath: string;

begin


  dbPath := ExtractFilePath(ParamStr(0)) + 'mpmBaza.mdb';

  if not FileExists(dbPath) then
  begin
    ShowMessage('Baza ne postoji na lokaciji: ' + dbPath);
    Exit;
  end;

  try
    ADOConnection1.ConnectionString :=
      'Provider=Microsoft.Jet.OLEDB.4.0;' +
      'Data Source=' + dbPath + ';';

    ADOConnection1.Connected := True;

  except
    on E: Exception do
      ShowMessage('Greška pri konekciji sa bazom: ' + E.Message);
  end;
end;

procedure TForm8.HambMeni2Click(Sender: TObject);
begin
PanelProdaja.Visible := not PanelProdaja.Visible;
HambMeni2.BringToFront;
end;

procedure TForm8.KarticaNoviZahteviClick(Sender: TObject);
begin
  Filtriranje(1);
  ZahteviLista.Visible := True;
end;

procedure TForm8.KarticaOdbijenePonudeClick(Sender: TObject);
begin
  Filtriranje(2);
  ZahteviLista.Visible := True;
end;

procedure TForm8.KarticaPoslatePonudeClick(Sender: TObject);
begin
  Filtriranje(3);
  ZahteviLista.Visible := True;
end;

procedure TForm8.KarticaPrihvacenePonudeClick(Sender: TObject);
begin
  Filtriranje(4);
  ZahteviLista.Visible := True;
end;

procedure TForm8.KarticaZahteviClick(Sender: TObject);
begin
  Filtriranje(0);

  ZahteviLista.Visible := not ZahteviLista.Visible;
  ZahteviLista.BringToFront;
  KarticaZahtevi.BringToFront;
end;
procedure TForm8.NoviZahtevDugmeClick(Sender: TObject);
begin
Form9.Left := Self.Left;
  Form9.Top := Self.Top;

  Form9.Width := Self.Width;
  Form9.Height := Self.Height;

  Form9.Show;
  Self.Hide;
end;



procedure TForm8.Filtriranje(StatusID: Integer);
var
  RectCard: TRectangle;
  TxtNaslov: TText;
  KlijentIme, GradIme: string;
begin

  ZahteviLista.DeleteChildren;

  ADOQuery1.Close;
  ADOQuery1.SQL.Clear;
  if StatusID = 0 then
  begin
    ADOQuery1.SQL.Text :=
      'SELECT Zahtevi.ZahtevID, Klijenti.nazivKlijenta, Gradovi.Grad ' +
      'FROM (Zahtevi ' +
      'LEFT JOIN Klijenti ON Zahtevi.KlijentID = Klijenti.IDKlijenta) ' +
      'LEFT JOIN Gradovi ON Klijenti.GradID = Gradovi.GradID ' +
      'ORDER BY Zahtevi.ZahtevID DESC';
  end
  else
  begin
    ADOQuery1.SQL.Text :=
      'SELECT Zahtevi.ZahtevID, Klijenti.nazivKlijenta, Gradovi.Grad ' +
      'FROM (Zahtevi ' +
      'LEFT JOIN Klijenti ON Zahtevi.KlijentID = Klijenti.IDKlijenta) ' +
      'LEFT JOIN Gradovi ON Klijenti.GradID = Gradovi.GradID ' +
      'WHERE Zahtevi.StatusID = :SID ' +
      'ORDER BY Zahtevi.ZahtevID DESC';
    ADOQuery1.Parameters.ParamByName('SID').Value := StatusID;
  end;

  ADOQuery1.Open;

  if ADOQuery1.Eof then
  begin
    ZahteviLista.Visible := False;
    ShowMessage('Nema zahteva za izabrani status.');
    Exit;
  end;
  while not ADOQuery1.Eof do
  begin
    KlijentIme := ADOQuery1.FieldByName('nazivKlijenta').AsString;
    GradIme := ADOQuery1.FieldByName('Grad').AsString;
    if GradIme = '' then GradIme := 'Nepoznat grad';

    RectCard := TRectangle.Create(ZahteviLista);
    RectCard.Parent := ZahteviLista;
    RectCard.Align := TAlignLayout.Top;
    RectCard.Height := 55;
    RectCard.Margins.Top := 4;
    RectCard.Margins.Bottom := 4;
    RectCard.Margins.Left := 10;
    RectCard.Margins.Right := 10;
    RectCard.XRadius := 8;
    RectCard.YRadius := 8;
    RectCard.Fill.Color := $FFF8F9FA;
    RectCard.Stroke.Color := $FFDEE2E6;

    RectCard.Tag := ADOQuery1.FieldByName('ZahtevID').AsInteger;
    RectCard.OnClick := KarticaKlijentaClick;
    TxtNaslov := TText.Create(RectCard);
    TxtNaslov.Parent := RectCard;
    TxtNaslov.Align := TAlignLayout.Client;
    TxtNaslov.Margins.Left := 15;
    TxtNaslov.Font.Size := 16;
    TxtNaslov.Font.Style := [TFontStyle.fsBold];
    TxtNaslov.TextSettings.HorzAlign := TTextAlign.Leading;
    TxtNaslov.Text := KlijentIme + ' (' + GradIme + ')';
    TxtNaslov.HitTest := False;

    ADOQuery1.Next;
  end;

  ZahteviLista.Visible := True;
  ZahteviLista.BringToFront;
end;
procedure TForm8.FormClose(Sender: TObject; var Action: TCloseAction);
var
  Ini: TIniFile;
begin
  Ini := TIniFile.Create(ExtractFilePath(ParamStr(0)) + 'settings.ini');
  try
    Ini.WriteInteger('Pozicija', 'Left', Self.Left);
    Ini.WriteInteger('Pozicija', 'Top', Self.Top);
  finally
    Ini.Free;
  end;
end;

end.
