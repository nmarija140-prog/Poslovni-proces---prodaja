  private
    PonudaSacuvana: Boolean;
    PonudaID: Integer;
    PonudaPostoji: Boolean;
    KlijentEmail: string;
    function GenerisiPDFAutomatski(out PutanjaDoPDFa: string): Boolean;
    function PosaljiMejlSaPonudom(const PrimaocEmail, PutanjaDoFajla: string): Boolean;
  public
